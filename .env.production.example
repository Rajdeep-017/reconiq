# ReconIQ production-like deployment environment.
#
#   Copy-Item .env.production.example .env.production
#   # edit POSTGRES_PASSWORD and SECRET_KEY
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Never commit .env.production. Use a secret manager or your platform's
# environment configuration in a real production deployment.

# ---- Host ports -----------------------------------------------------------
# Change these if the development stack is already using 5432/6379/8000.
FRONTEND_PORT=8080
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=reconiq
# Use a long alphanumeric value. If you need symbols, URL-encode them in the
# DATABASE_URL that Compose builds.
POSTGRES_PASSWORD=replace-with-a-strong-alphanumeric-password
POSTGRES_DB=reconiq

# ---- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- CORS -----------------------------------------------------------------
# JSON array of exact browser origins. With the bundled Nginx proxy the browser
# calls the same origin, so this is mainly for direct API clients and tooling.
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# ---- Redis / storage ------------------------------------------------------
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/app/storage/uploads
EXPORT_DIR=/app/storage/exports
MAX_UPLOAD_SIZE_MB=50

# ---- Migrations -----------------------------------------------------------
DATABASE_CONNECT_TIMEOUT=10
MIGRATION_CONNECT_ATTEMPTS=20
MIGRATION_RETRY_DELAY_SECONDS=3
RUN_MIGRATIONS=true

# ---- API process ----------------------------------------------------------
UVICORN_WORKERS=2
FORWARDED_ALLOW_IPS=*

# ---- Optional AI (advisory only) ------------------------------------------
# Ollama is not required. From inside a container, host.docker.internal points
# at the Docker host on Docker Desktop.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ---- Demo seed (never enable for a real customer deployment) --------------
DEMO_PASSWORD_FINANCE_EXECUTIVE=ExecDemo123!
DEMO_PASSWORD_FINANCE_COFOUNDER=CofounderDemo123!
