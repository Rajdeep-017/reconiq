# Copy to backend/.env for local development.
# When Alembic/backend runs inside Docker Compose, change the DB host to
# "postgres" (the Compose service name), not "localhost" or "127.0.0.1".

DATABASE_URL=postgresql+psycopg://reconiq:reconiq_dev@127.0.0.1:5432/reconiq
TEST_DATABASE_URL=postgresql+psycopg://reconiq:reconiq_dev@127.0.0.1:5432/reconiq_test

# Alembic waits for the database to accept connections during deployment.
DATABASE_CONNECT_TIMEOUT=10
MIGRATION_CONNECT_ATTEMPTS=10
MIGRATION_RETRY_DELAY_SECONDS=3

SECRET_KEY=replace-with-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=../storage/uploads
EXPORT_DIR=../storage/exports
MAX_UPLOAD_SIZE_MB=50

REDIS_URL=redis://localhost:6379/0
# Inside Docker Compose use: redis://redis:6379/0

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
